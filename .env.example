# Robinhood Chain RPC — the public endpoint is free but rate-limited.
# For production, use QuickNode, Alchemy, or Chainstack.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# API server port
PORT=3001

# How many blocks back to index on first run (0 = start from current block)
BACKFILL_BLOCKS=5000

# Polling interval in ms (250ms block time, so 500ms is fine)
POLL_INTERVAL=500

# Your Hood Watcher frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
